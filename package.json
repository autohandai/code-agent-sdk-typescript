{
  "name": "@autohandai/agent-sdk",
  "version": "1.1.1",
  "license": "Apache-2.0",
  "description": "Autohand Code Agent SDK - CLI wrapper implementation",
  "repository": {
    "type": "git",
    "url": "https://github.com/autohandai/code-agent-sdk-typescript"
  },
  "homepage": "https://autohand.ai/sdk/",
  "bugs": {
    "url": "https://github.com/autohandai/code-agent-sdk-typescript/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./claude": {
      "types": "./dist/compat/claude/index.d.ts",
      "import": "./dist/compat/claude/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "CHANGELOG.md",
    "docs/autoresearch.md",
    "docs/claude-compat.md",
    "docs/agent-cli-comparison.md",
    "docs/session-awareness.md",
    "docs/reliability-and-performance.md",
    "scripts/compare-agent-clis.ts",
    "scripts/benchmark-startup.mjs",
    "examples/27-autoresearch-ledger.ts",
    "examples/28-session-awareness.ts",
    "examples/29-weka-decisions.ts",
    "examples/session-awareness",
    "tsconfig.examples.json",
    "LICENSE",
    "COMPAT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "lint": "eslint src",
    "test": "bun test src/__tests__",
    "test:examples": "bun run examples/test-examples.ts",
    "compare:agents": "bun scripts/compare-agent-clis.ts",
    "benchmark:startup": "bun run build && node scripts/benchmark-startup.mjs",
    "build:example:structured-json": "node scripts/build-examples.mjs examples/25-structured-json.ts",
    "build:examples": "node scripts/build-examples.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:packaging && bun run build && bun run typecheck:examples && bun run test:examples && bun run build:examples && bun run lint",
    "cli:prepare": "node scripts/cli-packages.mjs prepare",
    "cli:verify": "node scripts/cli-packages.mjs verify",
    "cli:publish": "node scripts/cli-packages.mjs publish",
    "pack:check": "node scripts/check-package.mjs",
    "test:package": "bun run build && node scripts/test-package.mjs",
    "test:packaging": "bun test tests/cli-packages.test.mjs"
  },
  "keywords": [
    "sdk",
    "llm",
    "agent",
    "autohand",
    "cli-wrapper"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@autohandai/agent-compat-data": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "es-module-lexer": "1.7.0",
    "toml": "^5.0.0",
    "yaml": "^2.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sdk": "0.93.0",
    "@eslint/js": "^10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "globals": "^17",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@autohandai/agent-sdk-darwin-arm64": "0.9.8",
    "@autohandai/agent-sdk-darwin-x64": "0.9.8",
    "@autohandai/agent-sdk-linux-arm64": "0.9.8",
    "@autohandai/agent-sdk-linux-x64": "0.9.8",
    "@autohandai/agent-sdk-win32-x64": "0.9.8"
  },
  "bin": {
    "autohand-agent-sdk": "./dist/cli.js"
  }
}
